---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../lib/site';
---

<BaseLayout title={`Page not found — ${SITE_NAME}`} description="This page does not exist or has moved. Go to the home page to continue from there." noindex>
  <div class="container">
    <header class="page-header">
      <p class="page-header__eyebrow">404</p>
      <h1 class="page-header__title">Page not found.</h1>
      <p class="page-header__lead">The page you are looking for does not exist or has moved.</p>
      <p><a class="button button--primary" href="/">Go to the home page</a></p>
    </header>
  </div>
</BaseLayout>
