{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zyris-website manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "registry",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "registry": {
      "enum": [
        "ghcr.io"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "server": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "type",
        "serve"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^(?!(.*/)?\\.\\.(/|$))([A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*|\\.)$"
        },
        "type": {
          "enum": [
            "astro"
          ]
        },
        "dockerfile": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "serve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "behind-proxy",
                "standalone"
              ]
            },
            "network": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "hosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
              }
            },
            "email": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            }
          }
        }
      }
    }
  }
}
